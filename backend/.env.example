# Copy to backend/.env and adjust.

# Where datasets, models, optimized variants and uploads are stored.
EDGECRAFT_STORAGE_DIR=./data_storage

# Comma-separated browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost

# Optional shared secret. When set, every request needs header X-API-Key
# (enter the same value in the app's Settings page). Recommended whenever
# the backend listens on anything other than localhost.
EDGECRAFT_API_TOKEN=

# Upload limits (MB)
MAX_UPLOAD_MB=4096
MAX_CHUNK_MB=64
MAX_SAMPLE_MB=50

# LLM: OpenRouter (cloud) and/or Ollama (local)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OLLAMA_ENABLED=false
OLLAMA_MODEL=phi3
OLLAMA_HOST=http://localhost:11434

# Remote dataset sources (optional)
KAGGLE_USERNAME=
KAGGLE_KEY=
HUGGINGFACE_TOKEN=

# TensorFlow
TF_CPP_MIN_LOG_LEVEL=2
# float16 training on supported GPUs (models are always exported in float32)
MIXED_PRECISION=true
